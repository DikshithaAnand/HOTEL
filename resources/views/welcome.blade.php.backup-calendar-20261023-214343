    function setPage(page) {
        document.querySelectorAll('.nav-link[data-page]').forEach(link => {
            link.classList.toggle('active', link.dataset.page === page);
        });

        breadcrumbTitle.textContent = page;
        pageTitle.textContent = page === 'Dashboard' ? 'Good morning, Administrator' : page;
        sidebar.classList.remove('open');

        if (page === 'Dashboard') {
            content.innerHTML = originalDashboard;
            pageTitle.textContent = 'Good morning, Administrator';
            content.querySelector('.subtitle').textContent =
                "Here's what's happening at your property today.";
            attachDashboardHandlers();
            return;
        }

        const template = templates[page];
        if (!template) return;

        content.innerHTML = `
            <div class="page-heading">
                <div>
                    <h1 id="pageTitle">${template.title}</h1>
                    <div class="subtitle">${template.subtitle}</div>
                </div>
                <div class="date-label">${dateElement.textContent}</div>
            </div>
            <div class="preview-note">Live database records are displayed where connected. Some actions may still be under development.</div>
            ${template.body}
            <div class="footer">Temairazu Hotel Management System</div>
        `;

        attachSearchHandlers();
    }

    function attachSearchHandlers() {
        const pairs = [
            ['bookingSearch', 'bookingTable'],
            ['roomSearch', 'roomTable'],
            ['guestSearch', 'guestTable'],
            ['maintenanceSearch', 'maintenanceTable'],
            ['staffSearch', 'staffTable']
        ];

        pairs.forEach(([inputId, tableId]) => {
            const input = document.getElementById(inputId);
            const table = document.getElementById(tableId);
            if (!input || !table) return;

            input.addEventListener('input', () => {
                const query = input.value.toLowerCase();
                table.querySelectorAll('tbody tr').forEach(row => {
                    row.style.display = row.textContent.toLowerCase().includes(query) ? '' : 'none';
                });
            });
        });
    }

    function attachDashboardHandlers() {
        const period = document.getElementById('chartPeriod');
        if (!period) return;

        period.addEventListener('change', event => {
            const monthly = event.target.value === 'month';
            const values = monthly
                ? [[45,61],[60,73],[50,66],[70,85],[58,76],[79,93],[66,82]]
                : [[40,57],[55,70],[38,51],[67,83],[50,68],[75,91],[62,78]];

            document.querySelectorAll('#revenueChart .bar-group').forEach((group, index) => {
                const bars = group.querySelectorAll('.bar');
                bars[0].style.height = values[index][0] + '%';
                bars[1].style.height = values[index][1] + '%';
            });

            document.getElementById('chartLabels').innerHTML = monthly
                ? '<span>Week 1</span><span>Week 2</span><span>Week 3</span><span>Week 4</span><span>Week 5</span><span>Week 6</span><span>Week 7</span>'
                : '<span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>';
        });

        document.querySelectorAll('[data-page-link]').forEach(button => {
            button.addEventListener('click', () => setPage(button.dataset.pageLink));
        });
    }

    document.querySelectorAll('.nav-link[data-page]').forEach(link => {
        link.addEventListener('click', event => {
            event.preventDefault();
            setPage(link.dataset.page);
            history.replaceState(null, '', '#' + link.dataset.page.toLowerCase());
        });
    });

    document.getElementById('menuButton').addEventListener('click', () => {
        sidebar.classList.toggle('open');
    });

    document.addEventListener('click', event => {
        const button = event.target.closest('[data-not-ready]');
        if (button) {
            event.preventDefault();
            alert(button.dataset.notReady + ' is a preview action. API integration is needed before it can save real data.');
        }
    });

    attachDashboardHandlers();

    const initialPage = location.hash.replace('#', '').toLowerCase();
    const pageMap = {
        dashboard: 'Dashboard', bookings: 'Bookings', rooms: 'Rooms',
        guests: 'Guests', housekeeping: 'Housekeeping', maintenance: 'Maintenance',
        billing: 'Billing', reports: 'Reports', staff: 'Staff', settings: 'Settings'
    };
    if (pageMap[initialPage] && initialPage !== 'dashboard') {
        setPage(pageMap[initialPage]);
    }
});
