<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\Booking;
use App\Models\Room;
use App\Models\Guest;
use App\Models\Hotel;
use Carbon\Carbon;

class DashboardController extends Controller
{
    public function index()
    {
        $hotel = Hotel::where('slug', 'temairazu-hotel')->first();
        $hotelId = $hotel?->id;

        $bookings = Booking::query();
        $rooms = Room::query();
        $guests = Guest::query();

        if ($hotelId) {
            $bookings->where('hotel_id', $hotelId);
            $rooms->where('hotel_id', $hotelId);
            $guests->whereHas('bookings', function ($query) use ($hotelId) {
                $query->where('hotel_id', $hotelId);
            });
        }

        $totalBookings = (clone $bookings)->count();
        $totalRooms = (clone $rooms)->count();
        $availableRooms = (clone $rooms)->where('status', 'available')->count();
        $occupiedRooms = (clone $rooms)->where('status', 'occupied')->count();
        $totalGuests = (clone $guests)->count();

        $monthStart = Carbon::now()->startOfMonth();
        $nextMonthStart = Carbon::now()->addMonth()->startOfMonth();

        $revenueThisMonth = (clone $bookings)
            ->whereIn('status', ['confirmed', 'checked_in', 'checked_out'])
            ->where('created_at', '>=', $monthStart)
            ->where('created_at', '<', $nextMonthStart)
            ->sum('total_amount');

        $activeBookings = (clone $bookings)
            ->whereIn('status', ['pending', 'confirmed', 'checked_in'])
            ->count();

        $occupancyRate = $totalRooms > 0
            ? round(($occupiedRooms / $totalRooms) * 100)
            : 0;

        $recentBookings = (clone $bookings)
            ->with(['guest', 'rooms.roomType'])
            ->latest()
            ->take(5)
            ->get();

        $allBookings = (clone $bookings)
            ->with(['guest', 'rooms.roomType', 'invoice', 'payments'])
            ->latest()
            ->get();

        $allGuests = (clone $guests)
            ->withCount('bookings')
            ->latest()
            ->get();

        $allRooms = (clone $rooms)
            ->with('roomType')
            ->orderBy('room_number')
            ->get();

        return view('welcome', compact(
            'totalBookings',
            'totalRooms',
            'availableRooms',
            'occupiedRooms',
            'totalGuests',
            'revenueThisMonth',
            'activeBookings',
            'occupancyRate',
            'recentBookings',
            'allBookings',
            'allGuests',
            'allRooms'
        ));
    }
}
